<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="SampleData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\native\bin\ticketfees.dll" Link="ticketfees.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\native\bin\ticketfees.dll')" />
    <None Include="..\native\bin\libticketfees.so" Link="libticketfees.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\native\bin\libticketfees.so')" />
    <None Include="..\native\bin\libticketfees.dylib" Link="libticketfees.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\native\bin\libticketfees.dylib')" />
  </ItemGroup>
</Project>